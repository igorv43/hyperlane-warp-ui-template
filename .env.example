NEXT_PUBLIC_WALLET_CONNECT_ID=12345678901234567890123456789012
NEXT_PUBLIC_RPC_OVERRIDES='{"chain1":{"http":"https://..."}}'

# ── Administration Fee ─────────────────────────────────────────────────────────
# Taxa fixa em USD cobrada por transferência para manter a UI no ar. É convertida
# em tempo real (Binance→CoinGecko) para o nativo da chain de origem e cobrada NA
# MESMA transação do envio (uma só aprovação). Ver ADMINISTRATION_FEE_GUIDE.md.
#
# Valor da taxa (default 0.5). Zero desliga a taxa em todas as chains.
NEXT_PUBLIC_ADMIN_FEE_USD=0.5
# Carteiras que RECEBEM a taxa (formato nativo de cada chain). Vazio = taxa
# DESLIGADA naquela chain (nada é cobrado). Preencha só as que você opera.
NEXT_PUBLIC_ADMIN_FEE_WALLET_TERRACLASSIC=terra1...
NEXT_PUBLIC_ADMIN_FEE_WALLET_BSC=0x...
NEXT_PUBLIC_ADMIN_FEE_WALLET_ETHEREUM=0x...
NEXT_PUBLIC_ADMIN_FEE_WALLET_SOLANA=So11111111111111111111111111111111111111111
