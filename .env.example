NEXT_PUBLIC_WALLET_CONNECT_ID=12345678901234567890123456789012
NEXT_PUBLIC_RPC_OVERRIDES='{"chain1":{"http":"https://..."}}'

# ── Administration Fee ─────────────────────────────────────────────────────────
# Flat USD fee charged per transfer to keep the UI running. It is converted in
# real time (Binance→CoinGecko) to the origin chain's native token and charged
# IN THE SAME transaction as the transfer (a single approval). See
# ADMINISTRATION_FEE_GUIDE.md.
#
# Fee amount (default 0.5). Zero disables the fee on all chains.
NEXT_PUBLIC_ADMIN_FEE_USD=0.5
# Wallets that RECEIVE the fee (each chain's native format). Empty = fee
# DISABLED on that chain (nothing is charged). Fill in only the ones you run.
NEXT_PUBLIC_ADMIN_FEE_WALLET_TERRACLASSIC=terra1...
NEXT_PUBLIC_ADMIN_FEE_WALLET_BSC=0x...
NEXT_PUBLIC_ADMIN_FEE_WALLET_ETHEREUM=0x...
NEXT_PUBLIC_ADMIN_FEE_WALLET_SOLANA=So11111111111111111111111111111111111111111

# Memo written on Terra Classic transactions (Cosmos native memo field).
# Default "terraclassic-bridge". Empty = no memo. (EVM has no memo; Solana only
# via the Memo Program — here it is applied on Cosmos only.)
NEXT_PUBLIC_TX_MEMO=terraclassic-bridge

# ── Solana / Phantom Lighthouse compatibility ─────────────────────────────────
# Compute-unit limit requested for the Solana transferRemote transaction
# (default 1000000, same as the Hyperlane SDK). Lower it to leave CU headroom
# for Lighthouse instructions if needed (Solana per-tx cap is 1.4M CU).
NEXT_PUBLIC_SOLANA_CU_LIMIT=1000000
